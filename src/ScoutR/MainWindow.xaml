<Window x:Class="ScoutR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ScoutR"
        Title="ScoutR" Icon="Assets/ScoutR.ico" Width="1280" Height="780" MinWidth="900" MinHeight="500"
        Background="White" FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Ribbon: tab strip + grouped commands (Windows 10 Explorer style) -->
        <StackPanel Grid.Row="0">
            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                <Button x:Name="UpdateBtn" DockPanel.Dock="Right" Style="{StaticResource TopBtn}"
                        Margin="0,2,6,2" Click="UpdateBtn_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="UpdateBtnLabel" Text="{l:T Update_Check}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" Margin="6,2,0,0">
                    <Border Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1,1,1,0" Padding="16,4,16,5" Margin="0,0,0,-1">
                        <TextBlock Text="{l:T Tab_Home}" Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                </StackPanel>
                </DockPanel>
            </Border>
            <Border Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,0,1" Padding="4,4,4,0">
                <StackPanel Orientation="Horizontal">
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="4,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="{l:T Grp_Clipboard}" HorizontalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,3"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnCut" Style="{StaticResource ToolBtn}" Tag="&#xE8C6;" Content="{l:T Btn_Cut}" Click="Cut_Click"/>
                                <Button x:Name="BtnCopy" Style="{StaticResource ToolBtn}" Tag="&#xE8C8;" Content="{l:T Btn_Copy}" Click="CopyClip_Click"/>
                                <Button x:Name="BtnPaste" Style="{StaticResource ToolBtn}" Tag="&#xE77F;" Content="{l:T Btn_Paste}" Click="Paste_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="4,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="{l:T Grp_Organize}" HorizontalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,3"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnCopyTo" Style="{StaticResource ToolBtn}" Tag="&#xE8C8;" Content="{l:T Btn_CopyToOther}" Click="CopyTo_Click"/>
                                <Button x:Name="BtnMoveTo" Style="{StaticResource ToolBtn}" Tag="&#xE8DE;" Content="{l:T Btn_MoveToOther}" Click="MoveTo_Click"/>
                                <Button Style="{StaticResource ToolBtn}" Tag="&#xE8AB;" Content="{l:T Btn_Swap}" Click="Swap_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="4,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="{l:T Grp_Edit}" HorizontalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,3"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnDelete" Style="{StaticResource ToolBtn}" Tag="&#xE74D;" Content="{l:T Btn_Delete}" Click="Delete_Click"/>
                                <Button x:Name="BtnRename" Style="{StaticResource ToolBtn}" Tag="&#xE8AC;" Content="{l:T Btn_Rename}" Click="Rename_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="4,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="{l:T Grp_New}" HorizontalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,3"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnNewFolder" Style="{StaticResource ToolBtn}" Tag="&#xE8F4;" Content="{l:T Btn_NewFolder}" Click="NewFolder_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="4,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="{l:T Grp_View}" HorizontalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,3"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource ToolBtn}" Tag="&#xE72C;" Content="{l:T Btn_Refresh}" Click="Refresh_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Tree | Pane A | Pane B -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="120"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <!-- Quick access: fixed links, like Explorer -->
                <StackPanel DockPanel.Dock="Top" Margin="0,6,0,0">
                    <TextBlock Text="{l:T Quick_Header}" Foreground="{StaticResource MutedBrush}" Margin="10,0,10,4"/>
                    <ItemsControl x:Name="QuickList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="QuickLink_Click" Tag="{Binding Path}" ToolTip="{Binding Path}"
                                        Focusable="False" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="Transparent" Padding="14,3">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0"
                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="10,6,10,0"/>
                </StackPanel>
                <Grid DockPanel.Dock="Top" Margin="10,6,10,4">
                    <TextBlock Text="{l:T Tree_Header}" Foreground="{StaticResource MutedBrush}"/>
                </Grid>
                <!-- No horizontal scrolling: the tree always stays aligned on the left, with the drives. -->
                <TreeView x:Name="Tree" BorderThickness="0" Padding="0,2"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <TreeView.Resources>
                        <!-- Selection colours (tree follows the active pane, so it uses the accent tint) -->
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#CCE8FF"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#CCE8FF"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="Black"/>
                        <HierarchicalDataTemplate DataType="{x:Type l:TreeNodeVm}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <Grid Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding ShowShellIcon, Converter={StaticResource B2V}}"/>
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ItemIcon}"
                                                    Visibility="{Binding ShowDrawnIcon, Converter={StaticResource B2V}}"/>
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="{Binding GlyphBrush}" HorizontalAlignment="Center"
                                               Visibility="{Binding IsRoot, Converter={StaticResource B2V}}"/>
                                </Grid>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="Padding" Value="2,2"/>
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            <EventSetter Event="Selected" Handler="TreeItem_Selected"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="{StaticResource LineBrush}"/>
            <l:PaneView x:Name="ViewA" Grid.Column="2"/>
            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Center" Background="{StaticResource LineBrush}"/>
            <l:PaneView x:Name="ViewB" Grid.Column="4"/>
        </Grid>

        <!-- Status bar + update notice -->
        <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="10,3">
            <DockPanel>
                <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Margin="12,0,0,0"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
