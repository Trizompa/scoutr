<UserControl x:Class="ScoutR.IPropsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ScoutR">
    <UserControl.Resources>
        <!-- One iProperty: name on the left, editable value on the right -->
        <DataTemplate x:Key="PropRow">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="115"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" ToolTip="{Binding Label}" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding ReadOnly}" Padding="3,1" VerticalContentAlignment="Center">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ReadOnly}" Value="True">
                                    <Setter Property="Background" Value="#F3F3F3"/>
                                    <Setter Property="Foreground" Value="#606060"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="Background" Value="#F2F8FE"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>
        </DataTemplate>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="PanelBtn" TargetType="Button">
            <Setter Property="Padding" Value="14,2"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
    </UserControl.Resources>

    <DockPanel Background="White">
        <Border DockPanel.Dock="Top" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="10,3">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource NavBtn}" Content="&#xE711;"
                        ToolTip="{l:T IProps_Close}" Click="Close_Click"/>
                <Button x:Name="SaveBtn" DockPanel.Dock="Right" Style="{StaticResource PanelBtn}" Margin="6,0,8,0"
                        Content="{l:T IProps_Save}" Click="Save_Click" IsEnabled="False"/>
                <Button x:Name="RevertBtn" DockPanel.Dock="Right" Style="{StaticResource PanelBtn}"
                        Content="{l:T IProps_Revert}" Click="Revert_Click" IsEnabled="False"/>
                <TextBlock Text="iProperties" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="FileText" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="InfoText" Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <Grid x:Name="Body" Margin="12,8,12,8" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{l:T IProps_Summary}" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl ItemsSource="{Binding Summary}" ItemTemplate="{StaticResource PropRow}" Focusable="False"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{l:T IProps_Project}" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl ItemsSource="{Binding Project}" ItemTemplate="{StaticResource PropRow}" Focusable="False"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="{l:T IProps_Custom}" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl ItemsSource="{Binding Custom}" ItemTemplate="{StaticResource PropRow}" Focusable="False"/>
                    <TextBlock x:Name="NoCustom" Text="{l:T IProps_NoCustom}" Foreground="{StaticResource MutedBrush}"
                               FontStyle="Italic"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
