<UserControl x:Class="ScoutR.IPropsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ScoutR">
    <UserControl.Resources>
        <!-- One iProperty: name on the left, editable value on the right -->
        <DataTemplate x:Key="PropRow">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="115"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" ToolTip="{Binding Label}" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding ReadOnly}" Padding="3,1" VerticalContentAlignment="Center">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ReadOnly}" Value="True">
                                    <Setter Property="Background" Value="#F3F3F3"/>
                                    <Setter Property="Foreground" Value="#606060"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="Background" Value="#F2F8FE"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>
        </DataTemplate>
        <!-- Custom property: same as above plus a delete button -->
        <DataTemplate x:Key="CustomRow">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                        Width="22" Margin="4,0,0,0" Focusable="False" Cursor="Hand" ToolTip="{l:T IProps_Delete}"
                        Tag="{Binding}" Click="DeleteCustom_Click" Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource MutedBrush}"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PropRow}" Focusable="False"/>
            </DockPanel>
        </DataTemplate>
        <Style x:Key="LinkBtn" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="6,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="PanelBtn" TargetType="Button">
            <Setter Property="Padding" Value="14,2"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
    </UserControl.Resources>

    <DockPanel Background="White">
        <Border DockPanel.Dock="Top" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="10,3">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource NavBtn}" Content="&#xE711;"
                        ToolTip="{l:T IProps_Close}" Click="Close_Click"/>
                <Button x:Name="SaveBtn" DockPanel.Dock="Right" Style="{StaticResource PanelBtn}" Margin="6,0,8,0"
                        Content="{l:T IProps_Save}" Click="Save_Click" IsEnabled="False"/>
                <Button x:Name="RevertBtn" DockPanel.Dock="Right" Style="{StaticResource PanelBtn}"
                        Content="{l:T IProps_Revert}" Click="Revert_Click" IsEnabled="False"/>
                <!-- Choose which standard fields are shown -->
                <Button x:Name="FieldsBtn" DockPanel.Dock="Right" Style="{StaticResource LinkBtn}" Margin="0,0,10,0"
                        Click="Fields_Click" ToolTip="{l:T IProps_FieldsTip}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{l:T IProps_Fields}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="iProperties" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="FileText" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="InfoText" Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <Grid x:Name="Body" Margin="12,8,12,8" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Thumbnail, as Explorer shows it -->
                <!-- Thumbnail, as Explorer shows it: top level with the first field, about 6 fields tall -->
                <Border x:Name="ThumbBox" Grid.Column="0" Width="140" Height="140" Margin="0,22,0,0"
                        VerticalAlignment="Top" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        Background="White">
                    <Image x:Name="Thumb" Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <!-- Vertical dividers between the groups -->
                <Rectangle Grid.Column="1" Width="1" HorizontalAlignment="Center" Fill="{StaticResource LineBrush}"/>
                <Rectangle Grid.Column="3" Width="1" HorizontalAlignment="Center" Fill="{StaticResource LineBrush}"/>
                <Rectangle Grid.Column="5" Width="1" HorizontalAlignment="Center" Fill="{StaticResource LineBrush}"/>
                <Rectangle Grid.Column="7" Width="1" HorizontalAlignment="Center" Fill="{StaticResource LineBrush}"/>
                <StackPanel x:Name="SummaryCol" Grid.Column="2" Width="300">
                    <TextBlock Text="{l:T IProps_Summary}" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl x:Name="SummaryItems" Margin="0,0,26,0" ItemsSource="{Binding Summary}" ItemTemplate="{StaticResource PropRow}" Focusable="False"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Width="300">
                    <TextBlock Text="{l:T IProps_Project}" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl x:Name="ProjectItems" Margin="0,0,26,0" ItemsSource="{Binding Project}" ItemTemplate="{StaticResource PropRow}" Focusable="False"/>
                </StackPanel>
                <StackPanel Grid.Column="6" Width="300">
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkBtn}" Click="AddCustom_Click"
                                ToolTip="{l:T IProps_AddTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,5,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{l:T IProps_Add}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{l:T IProps_Custom}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Custom}" ItemTemplate="{StaticResource CustomRow}" Focusable="False"/>
                    <TextBlock x:Name="NoCustom" Text="{l:T IProps_NoCustom}" Foreground="{StaticResource MutedBrush}"
                               FontStyle="Italic"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
