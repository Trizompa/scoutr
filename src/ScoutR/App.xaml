<Application x:Class="ScoutR.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Windows 10 style palette -->
        <SolidColorBrush x:Key="AccentBrush" Color="#0078D7"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#E5F3FF"/>
        <SolidColorBrush x:Key="SelBrush" Color="#CCE8FF"/>
        <SolidColorBrush x:Key="SelBorderBrush" Color="#99D1FF"/>
        <SolidColorBrush x:Key="SelInactiveBrush" Color="#D9D9D9"/>
        <SolidColorBrush x:Key="LineBrush" Color="#DADBDC"/>
        <SolidColorBrush x:Key="ChromeBrush" Color="#F5F6F7"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#6D6D6D"/>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <!-- Small flat icon button (back / up) -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ribbon-like toolbar button: Tag = icon glyph, Content = label -->
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" MinWidth="62" Padding="6,4">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                                <ContentPresenter HorizontalAlignment="Center" Margin="0,3,0,0"
                                                  TextElement.FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SelBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bottom function-key bar button -->
        <Style x:Key="FKeyBtn" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="0,0,1,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat column header (no gradient, thin separators) -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid>
                            <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="0,0,0,1" Padding="8,4">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                            <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="8"
                                   Margin="0,0,-4,0" Background="Transparent" Cursor="SizeWE">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="Transparent">
                                            <Rectangle Width="1" Margin="0,3" HorizontalAlignment="Center"
                                                       Fill="{StaticResource LineBrush}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filled folder / coloured document icon, drawn so it looks like Explorer (needs GlyphBrush, IsFolderShape, IsFileShape) -->
        <DataTemplate x:Key="ItemIcon">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M2,5 L9,5 L11,7 L22,7 L22,19 L2,19 Z" Fill="{Binding GlyphBrush}"
                          Visibility="{Binding IsFolderShape, Converter={StaticResource B2V}}"/>
                    <Path Data="M2,9 L22,9 L22,19 L2,19 Z" Fill="#40FFFFFF"
                          Visibility="{Binding IsFolderShape, Converter={StaticResource B2V}}"/>
                    <Path Data="M5,2 L14,2 L19,7 L19,22 L5,22 Z" Fill="White" Stroke="{Binding GlyphBrush}"
                          StrokeThickness="1.5" Visibility="{Binding IsFileShape, Converter={StaticResource B2V}}"/>
                    <Path Data="M14,2 L14,7 L19,7" Stroke="{Binding GlyphBrush}" StrokeThickness="1.5"
                          Visibility="{Binding IsFileShape, Converter={StaticResource B2V}}"/>
                    <Rectangle Canvas.Left="5.7" Canvas.Top="15" Width="12.6" Height="6.3" Fill="{Binding GlyphBrush}"
                               Visibility="{Binding IsFileShape, Converter={StaticResource B2V}}"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- Address bar segment -->
        <Style x:Key="CrumbBtn" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" Padding="5,2">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
