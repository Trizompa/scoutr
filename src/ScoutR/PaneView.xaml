<UserControl x:Class="ScoutR.PaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ScoutR">
    <UserControl.Resources>
        <!-- Row look: blue selection in the active pane, grey in the inactive one (like Explorer). -->
        <Style x:Key="RowStyle" TargetType="ListViewItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <EventSetter Event="MouseDoubleClick" Handler="Row_DoubleClick"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" Padding="0,3">
                            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                  Columns="{TemplateBinding GridView.ColumnCollection}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelInactiveBrush}"/>
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListView}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SelBorderBrush}"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Active pane marker -->
        <Border Grid.Row="0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!-- Back / Up / address / filter -->
        <Grid Grid.Row="1" Margin="6,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource NavBtn}" Content="&#xE72B;"
                    ToolTip="{l:T Tip_Back}" Click="Back_Click" IsEnabled="{Binding CanGoBack}"/>
            <Button Grid.Column="1" Style="{StaticResource NavBtn}" Content="&#xE74A;"
                    ToolTip="{l:T Tip_Up}" Click="Up_Click"/>
            <Border Grid.Column="2" Margin="4,0" BorderThickness="1" Background="White" Height="26"
                    MouseLeftButtonDown="AddressBorder_MouseDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <ItemsControl x:Name="CrumbBar" ItemsSource="{Binding Crumbs}" VerticalAlignment="Center"
                                  ClipToBounds="True" Margin="2,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource CrumbBtn}" Content="{Binding Name}"
                                            Tag="{Binding Target}" Click="Crumb_Click"/>
                                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox x:Name="AddressBox" Text="{Binding DisplayPath, Mode=OneWay}" BorderThickness="0"
                             VerticalContentAlignment="Center" Padding="4,0" Visibility="Collapsed"
                             KeyDown="AddressBox_KeyDown" LostKeyboardFocus="AddressBox_LostFocus"/>
                </Grid>
            </Border>
            <Grid Grid.Column="3">
                <TextBox Height="26" VerticalContentAlignment="Center" Padding="4,0,22,0"
                         BorderBrush="{StaticResource LineBrush}" ToolTip="{l:T Tip_Filter}"
                         Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{Binding SearchPlaceholder}" Margin="6,0,24,0" VerticalAlignment="Center"
                           IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource MutedBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Filter}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,7,0"
                           HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{StaticResource MutedBrush}"/>
            </Grid>
        </Grid>

        <ListView x:Name="ItemList" Grid.Row="2" BorderThickness="0" SelectionMode="Extended"
                  ItemsSource="{Binding Items}" ItemContainerStyle="{StaticResource RowStyle}"
                  Tag="{Binding IsActive}" SelectionChanged="ItemList_SelectionChanged"
                  KeyDown="ItemList_KeyDown" VirtualizingPanel.IsVirtualizing="True"
                  PreviewMouseRightButtonDown="ItemList_RightDown"
                  PreviewMouseLeftButtonDown="ItemList_LeftDown"
                  PreviewMouseLeftButtonUp="ItemList_LeftUp" PreviewMouseMove="ItemList_MouseMove"
                  AllowDrop="True" DragOver="ItemList_DragOver" Drop="ItemList_Drop"
                  GridViewColumnHeader.Click="Header_Click">
            <ListView.View>
                <GridView AllowsColumnReorder="False">
                    <GridViewColumn Header="{l:T Col_Name}" Width="230">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding HasIcon, Converter={StaticResource B2V}}"/>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ItemIcon}"
                                                        Visibility="{Binding NoIcon, Converter={StaticResource B2V}}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{l:T Col_Modified}" Width="130"
                                    DisplayMemberBinding="{Binding ModifiedText}"/>
                    <GridViewColumn Header="{l:T Col_Type}" Width="140" DisplayMemberBinding="{Binding TypeText}"/>
                    <GridViewColumn Header="{l:T Col_Size}" Width="80" DisplayMemberBinding="{Binding SizeText}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="8,3">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding CountText}" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock x:Name="SelText" Margin="14,0,0,0" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
